#!/bin/sh
# Before a push: the fast tests (the service worker's stamp, precache list and manifest; under a second), so a push
# never carries a stale shell. The browser suites (tests/smoke.cjs, tests/e2e-pwa.cjs) stay manual.
# `git push --no-verify` skips this. Active in a clone once `git config core.hooksPath .githooks` is set.
if ! command -v node >/dev/null 2>&1; then
  echo 'pre-push: node is not on PATH, so the tests cannot run (git push --no-verify skips them)' >&2
  exit 1
fi
node --test --test-reporter=dot tests/sw.test.mjs || exit 1
